{#
  Proxmox VE automated-installation answer file, rendered per host.

  Validate with:  proxmox-auto-install-assistant validate-answer <file>

  Every lookup below carries a default so a missing inventory value produces an
  answer file that fails validation loudly, rather than a template crash that
  hides which host was being rendered.
-#}
# Generated by pve-deploy os_install for {{ os_install_fqdn | default('UNSET') }}
# Source of truth is the inventory; do not edit this file in place.

[global]
keyboard = "{{ os_install_keyboard | default('en-us') }}"
country = "{{ os_install_country | default('') }}"
fqdn = "{{ os_install_fqdn | default('') }}"
mailto = "{{ os_install_mailto | default('') }}"
timezone = "{{ os_install_timezone | default('UTC') }}"
root-password = "{{ os_install_root_password | default('') }}"
{% if os_install_root_ssh_keys | default([]) | length > 0 %}
root-ssh-keys = [
{% for key in os_install_root_ssh_keys %}
  "{{ key }}"{{ "," if not loop.last else "" }}
{% endfor %}
]
{% endif %}

{# ---------------------------------------------------------------------------
   Network.

   This section is MANDATORY -- the parser rejects an answer file without it
   ("missing field `network`") -- but on this hardware the values it writes are
   inert on arrival.

   The answer format describes exactly one interface and cannot express a bond
   or a VLAN tag. Where every server port is an LACP member carrying tagged
   VLANs, the installed node therefore comes up on a single untagged link facing
   a port that will not pass its traffic. It is unreachable over the network no
   matter what is written here.

   So these values are not what makes the node reachable; 11-network is, applied
   over Serial-over-LAN. What they do provide is the correct final addressing,
   so that once the real topology is in place the host already agrees with the
   inventory instead of needing a second pass.

   from-dhcp is deliberately not used: there is no DHCP on PVE Management, so
   the installer would stall waiting for a lease that never arrives.
--------------------------------------------------------------------------- #}
[network]
source = "{{ os_install_network_source | default('from-answer') }}"
{% if (os_install_network_source | default('from-answer')) != 'from-dhcp' %}
cidr = "{{ os_install_cidr | default('') }}"
gateway = "{{ os_install_gateway | default('') }}"
dns = "{{ os_install_dns | default('') }}"
{# MANDATORY with source = from-answer. Not optional, and there is no default
   the installer can fall back on -- with eight identical NICs there is no such
   thing as "the obvious one".

   Omitting it aborts the install with "ERROR: Installation failed: no filter
   defined" at the network step, which happens BEFORE disk setup. So the
   failure looks like a stall rather than a rejection: the installer boots,
   reads the answer, prints one line and stops, having written nothing. #}
{% for k, v in (os_install_nic_filter | default({})).items() %}
filter.{{ k }} = "{{ v }}"
{% endfor %}
{% endif %}

[disk-setup]
filesystem = "{{ os_install_filesystem | default('zfs') }}"
{% if (os_install_filesystem | default('zfs')) == 'zfs' %}
zfs.raid = "{{ os_install_zfs_raid | default('raid1') }}"
{% endif %}
{% if os_install_disk_filter | default({}) | length > 0 %}
{# Filter rather than disk-list: a device name is an enumeration accident, and
   installing to the wrong disk is the failure this role must not have. #}

[disk-setup.filter]
{% for k, v in os_install_disk_filter.items() %}
{{ k }} = "{{ v }}"
{% endfor %}
{% elif os_install_disk_list | default([]) | length > 0 %}
disk-list = [{% for d in os_install_disk_list %}"{{ d }}"{{ ", " if not loop.last else "" }}{% endfor %}]
{% endif %}
{% if os_install_first_boot_enabled | default(false) | bool %}

[first-boot]
source = "{{ os_install_first_boot_source | default('from-iso') }}"
ordering = "{{ os_install_first_boot_ordering | default('before-network') }}"
{% endif %}
