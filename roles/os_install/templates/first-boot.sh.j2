#!/bin/bash
# First-boot network bootstrap for {{ os_install_fqdn }}
#
# Generated by pve-deploy os_install. Do not edit on the installed host: it runs
# once, at first boot, and is replaced wholesale by the next install.
#
#
# WHY THIS EXISTS
#
# The Proxmox answer file describes exactly one interface and cannot express a
# bond or a VLAN tag. Every server port here is an LACP member carrying tagged
# VLANs, so a freshly installed node comes up on a single untagged link facing a
# port that will not pass its traffic: installed, but unreachable.
#
# Without this hook the only way in is Serial-over-LAN, and every node would
# need hands before Ansible could touch it. This writes just enough network for
# 11-network to reach the host and take over.
#
#
# DELIBERATELY MINIMAL
#
# Management bond and its VLAN only. The remaining bonds, the SDN underlay, Ceph
# networks, MTU policy and bridges are 11-network's job, and it is the authority
# on them. Duplicating that here would create a second definition of the
# topology that could disagree with the first -- and this copy is the one nobody
# would think to update.
#
# So: enough to be reachable, nothing more.

set -u

LOG=/var/log/pve-first-boot.log
exec > >(tee -a "$LOG") 2>&1
echo "=== pve-deploy first-boot network bootstrap: $(date -Is) ==="

BOND="{{ os_install_first_boot_bond }}"
VLAN="{{ os_install_first_boot_vlan }}"
CIDR="{{ os_install_cidr }}"
GATEWAY="{{ os_install_gateway }}"
SLAVES="{{ os_install_first_boot_slaves | join(' ') }}"
BOND_MTU="{{ os_install_first_boot_bond_mtu }}"
VLAN_MTU="{{ os_install_first_boot_vlan_mtu }}"

echo "target: ${BOND}.${VLAN} ${CIDR} via ${GATEWAY} over [${SLAVES}]"

# Verify the expected NICs exist before touching anything.
#
# The names come from the inventory's cabling table and are PCI-topology
# derived, so they survive a reinstall -- but "should" is not "did". If they are
# absent the hardware or the cabling is not what the inventory believes, and
# writing a config against names that do not exist would replace a reachable-by-
# console node with a broken one. Bail out instead and leave the installer's
# own configuration in place; the node stays reachable over SoL.
missing=""
for s in $SLAVES; do
    [ -e "/sys/class/net/$s" ] || missing="$missing $s"
done
if [ -n "$missing" ]; then
    echo "ABORT: expected bond slave(s) not present:$missing"
    echo "       present interfaces: $(ls /sys/class/net | tr '\n' ' ')"
    echo "       leaving the installer's network configuration untouched."
    echo "       reach this host over Serial-over-LAN and configure by hand."
    exit 0
fi

# ifupdown2 ships with Proxmox VE and understands bond/VLAN stanzas. Confirm it
# rather than assume: on a stock Debian the plain ifupdown would silently ignore
# the bond options and bring up a link that never negotiates LACP.
if ! dpkg -s ifupdown2 >/dev/null 2>&1; then
    echo "ABORT: ifupdown2 is not installed; refusing to write bond configuration."
    exit 0
fi

STAMP=$(date +%Y-%m-%dT%H%M%S)
cp -a /etc/network/interfaces "/etc/network/interfaces.installer.$STAMP"
echo "saved installer config as /etc/network/interfaces.installer.$STAMP"

slave_stanzas=""
for s in $SLAVES; do
    slave_stanzas="${slave_stanzas}auto ${s}
iface ${s} inet manual
    mtu ${BOND_MTU}

"
done

cat > /etc/network/interfaces <<EOF
# Written by pve-deploy first-boot bootstrap on ${STAMP}.
#
# MANAGEMENT REACHABILITY ONLY. Phase 11-network owns the full topology --
# remaining bonds, SDN underlay, Ceph networks, bridges and MTU policy -- and
# will replace this file. Do not extend it here.
#
# Previous (installer-written) version: /etc/network/interfaces.installer.${STAMP}

auto lo
iface lo inet loopback

${slave_stanzas}auto ${BOND}
iface ${BOND} inet manual
    bond-slaves ${SLAVES}
    bond-mode 802.3ad
    bond-miimon 100
    bond-lacp-rate slow
    bond-xmit-hash-policy layer3+4
    mtu ${BOND_MTU}

auto ${BOND}.${VLAN}
iface ${BOND}.${VLAN} inet static
    address ${CIDR}
    gateway ${GATEWAY}
    mtu ${VLAN_MTU}
EOF

echo "--- written /etc/network/interfaces ---"
cat /etc/network/interfaces

{% if os_install_serial_console_enabled | default(true) | bool %}

# ---------------------------------------------------------------------------
# Serial console, so that breaking the network above is survivable
# ---------------------------------------------------------------------------
#
# What this hook just wrote is exactly the kind of change that can cut the only
# path to the machine, and 11-network then rewrites it again. Without a console
# that is a one-way door: a node whose bond does not come up has no way in at
# all except the BMC's graphical console.
#
# A serial console over SoL is the way back, and it has to be configured here
# because a stock Proxmox install has none -- no console= on the kernel command
# line, and therefore no getty.
#
# THIS IS A SAFETY NET, NOT THE AUTHORITY.
#
# pve_baseline (phase 10) owns the installed kernel command line and writes it
# wholesale, already including both consoles. This exists only to cover the
# window before phase 10 has run -- which is precisely when a node is most
# likely to come up unreachable and least likely to have anyone watching. Once
# phase 10 has run, the check below finds the console already configured and
# this becomes a no-op.
#
# So: do not extend this to other boot settings, and do not treat it as the
# place to change the console. Change pve_kernel_cmdline_default.
echo "=== configuring serial console ==="

SERIAL_SPEED="{{ os_install_serial_speed | default(115200) }}"
SERIAL_DEV="{{ os_install_serial_device | default('') }}"

# Discovered rather than assumed, because which UART is wired to the BMC varies
# by server model. /proc/tty/driver/serial lists every port the kernel probed
# and marks those with no real hardware as "uart:unknown", so the first entry
# that is not unknown is the first real port. On this fleet that is ttyS0 (a
# 16550A at 0x3f8); on another model it may well not be.
if [ -z "$SERIAL_DEV" ]; then
    SERIAL_DEV=$(awk -F: '/^[0-9]+:/ && !/uart:unknown/ {print "ttyS" $1; exit}' \
                 /proc/tty/driver/serial 2>/dev/null)
    echo "autodetected serial device: ${SERIAL_DEV:-none}"
else
    echo "serial device pinned by inventory: $SERIAL_DEV"
fi

if [ -z "$SERIAL_DEV" ] || [ ! -e "/dev/$SERIAL_DEV" ]; then
    echo "WARNING: no usable serial port found; skipping serial console setup."
    echo "         this node will have NO out-of-band console -- recovery from a"
    echo "         bad network configuration means the BMC graphical console."
else
    CONSOLE_ARGS="console=tty0 console=${SERIAL_DEV},${SERIAL_SPEED}"

    # Two boot paths, and picking the wrong one silently does nothing at all.
    #
    # A ZFS-root UEFI install is managed by proxmox-boot-tool, where the command
    # line lives in /etc/kernel/cmdline -- and /etc/default/grub is inert:
    # present on disk, read by nobody. Editing GRUB there looks like it worked
    # and changes no boot. Which one is live has to be detected, not assumed.
    if command -v proxmox-boot-tool >/dev/null 2>&1 && [ -f /etc/kernel/cmdline ]; then
        echo "boot path: proxmox-boot-tool (/etc/kernel/cmdline)"
        if grep -q "console=${SERIAL_DEV}" /etc/kernel/cmdline; then
            echo "already configured; leaving /etc/kernel/cmdline alone"
        else
            cp -a /etc/kernel/cmdline "/etc/kernel/cmdline.pre-serial.${STAMP}"
            # Appended, not rewritten, so the root= and boot= arguments the
            # installer chose are left exactly as they are.
            sed -i "1 s|\$| ${CONSOLE_ARGS}|" /etc/kernel/cmdline
            echo "new cmdline: $(cat /etc/kernel/cmdline)"
            # Bounded, like every external command in this section.
            #
            # This unit is ordered before-network and systemd gives it NO
            # timeout, so anything that blocks here strands the machine with no
            # network and no console -- unrecoverable without the BMC's
            # graphical console. A serial console is a convenience; hanging the
            # boot to configure one is not a trade worth making, so each step is
            # allowed to fail rather than wait forever.
            timeout 120 proxmox-boot-tool refresh || echo "WARNING: proxmox-boot-tool refresh failed or timed out"
        fi
    elif [ -f /etc/default/grub ]; then
        echo "boot path: grub (/etc/default/grub)"
        if grep -q "console=${SERIAL_DEV}" /etc/default/grub; then
            echo "already configured; leaving /etc/default/grub alone"
        else
            cp -a /etc/default/grub "/etc/default/grub.pre-serial.${STAMP}"
            sed -i "s|^GRUB_CMDLINE_LINUX=\"\(.*\)\"|GRUB_CMDLINE_LINUX=\"\1 ${CONSOLE_ARGS}\"|" \
                   /etc/default/grub
            sed -i "s|^#*GRUB_TERMINAL=.*|GRUB_TERMINAL=\"console serial\"|" /etc/default/grub
            if ! grep -q "^GRUB_SERIAL_COMMAND=" /etc/default/grub; then
                SERIAL_UNIT="${SERIAL_DEV#ttyS}"
                echo "GRUB_SERIAL_COMMAND=\"serial --unit=${SERIAL_UNIT} --speed=${SERIAL_SPEED}\"" \
                     >> /etc/default/grub
            fi
            timeout 120 update-grub || echo "WARNING: update-grub failed or timed out"
        fi
    else
        echo "WARNING: neither proxmox-boot-tool nor /etc/default/grub is present;"
        echo "         cannot configure a boot-time serial console."
    fi

    # No `systemctl enable serial-getty@...` on purpose: systemd's getty
    # generator creates and starts that unit by itself once console= names a
    # serial port. Enabling it by hand would add a second source of truth that
    # can disagree with the kernel command line.
    #
    # The command line only takes effect at the NEXT boot, though, and the
    # window this console exists for -- 11-network rewriting the network --
    # opens before then. So start a getty for the current boot too; from the
    # next reboot the generator owns it.
    # --no-block is NOT optional here, and leaving it out hangs the node forever.
    #
    # This script runs as a systemd unit, and a blocking `systemctl start` waits
    # for the new job to finish -- which systemd will not schedule until the
    # transaction containing THIS unit completes. The two wait on each other.
    # Because the unit is ordered before-network and has no timeout, the result
    # is a machine stuck at
    #     Job proxmox-first-boot-network-pre...start running (53min / no limit)
    # with no network and therefore no way in. That is exactly what it did on
    # pve-02.
    #
    # --no-block enqueues the job and returns immediately, so the getty starts
    # once this unit is out of the way.
    systemctl --no-block start "serial-getty@${SERIAL_DEV}.service" 2>/dev/null \
        && echo "getty queued on ${SERIAL_DEV} for the current boot" \
        || echo "note: could not queue a getty on ${SERIAL_DEV} for this boot"

    echo "serial console configured: ${SERIAL_DEV} @ ${SERIAL_SPEED}"
fi
{% endif %}

# Not applying the config here.
#
# This hook runs before-network on first boot, so the normal networking start-up
# that follows will read what was just written. Bringing interfaces up by hand
# now would race that, and LACP needs a moment to negotiate with the switch
# before the VLAN interface can carry traffic.
echo "=== done; networking will start with this configuration ==="
exit 0
